# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing & Coverage
/coverage
*.lcov

# Next.js Build Outputs
/.next/
/out/
/build

# Database & SQLite Binaries
*.db-journal
*.sqlite-journal
prisma/*.db-journal
*.db
*.sqlite
prisma/*.db
prisma/*.sqlite

# Runtime Uploads & Generated Media
public/uploads/*
!public/uploads/.gitkeep

# Environment Files & Local Secrets (NEVER committed to Git)
.env
.env*.local
.env.development
.env.test
.env.production
!.env.example
*.local
.secrets*

# IDE & Editor Settings
.vscode/
.idea/
*.swp
*.swo

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Debug Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & Deployment
.vercel

# TypeScript & Cache
*.tsbuildinfo
next-env.d.ts
