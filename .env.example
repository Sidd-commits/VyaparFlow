# ==============================================================================
# VyaparFlow — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
#
# DO NOT commit real API secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Prisma ORM & PostgreSQL / Supabase)
# ------------------------------------------------------------------------------
# Transaction pooler connection URL (for runtime queries):
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct session connection URL (for Prisma migrations & schema pushing):
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# 2. Cryptographic Session Token Secret
# ------------------------------------------------------------------------------
SESSION_SECRET="your_secure_random_hmac_secret_key_here"

# ------------------------------------------------------------------------------
# 3. Sandbox.co.in GST & Compliance API (Optional for Live Lookups)
# ------------------------------------------------------------------------------
# Leave empty to use deterministic offline fallback generator for testing.
SANDBOX_API_KEY=""
SANDBOX_API_SECRET=""
SANDBOX_API_VERSION="1.0.0"

# ------------------------------------------------------------------------------
# 4. Google OAuth 2.0 Authentication (Optional for Live Google Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 5. Platform Administrator Security Configuration
# ------------------------------------------------------------------------------
# Strictly server-controlled Platform Administrator identity.
ADMIN_EMAIL="admin@vyaparflow.com"

# ------------------------------------------------------------------------------
# 6. Application Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
