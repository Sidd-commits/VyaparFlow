# ==============================================================================
# VyaparFlow — Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local:
#   cp .env.example .env
#
# DO NOT commit real API secrets or credentials to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Prisma ORM)
# ------------------------------------------------------------------------------
# For local development with SQLite:
DATABASE_URL="file:./dev.db"

# For PostgreSQL / MySQL (Production):
# DATABASE_URL="postgresql://user:password@localhost:5432/vyaparflow?schema=public"

# ------------------------------------------------------------------------------
# 2. Sandbox.co.in GST & Compliance API (Optional for Live Lookups)
# ------------------------------------------------------------------------------
# Leave empty to use deterministic offline fallback generator for testing.
SANDBOX_API_KEY=""
SANDBOX_API_SECRET=""
SANDBOX_API_VERSION="1.0.0"
# SANDBOX_ACCESS_TOKEN=""

# ------------------------------------------------------------------------------
# 3. Google OAuth 2.0 Authentication (Optional for Live Google Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console > APIs & Services > Credentials > OAuth 2.0 Client IDs
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 4. Application Settings
# ------------------------------------------------------------------------------
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
